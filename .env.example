# Copy to .env and edit. STORE_URL is the only one you must set; the rest have defaults.
# Keep comments on their own lines: systemd's EnvironmentFile treats "KEY=value  # note" as part of the value.

# ----- Store -----
STORE_URL=https://yourstore.tebex.io
STORE_NAME=Your Store
# ISO currency code used to format money in the dashboard
CURRENCY=USD

# ----- Polling -----
# seconds between checks of the Recent Payments widget (Cloudflare caches the page ~90s)
POLL_INTERVAL=30
# seconds between product/price catalog refreshes
CATALOG_INTERVAL=3600
# import the purchases already visible on first start (source=seed)
SEED_EXISTING=1
# min | max | avg: price to book when a truncated name matches several products
AMBIGUOUS_PRICE_POLICY=avg
# optional checkout sale estimate. Example: 25% off baskets of $19.99+
CHECKOUT_DISCOUNT_PERCENT=0
CHECKOUT_DISCOUNT_MIN_BASKET=0
# widget clock offset from UTC in minutes (e.g. -240); leave unset to auto-calibrate
#WIDGET_TZ_OFFSET_MIN=0
# curl_cffi TLS profile: chrome | edge | safari | firefox
IMPERSONATE=chrome

# players whose purchases are never recorded (your own test buys, staff): usernames or UUIDs, comma-separated
IGNORED_PLAYERS=

# ----- Dashboard -----
HOST=0.0.0.0
PORT=8787
DASHBOARD_USER=admin
# set this before exposing the dashboard to the internet
DASHBOARD_PASSWORD=

# ----- Notifications -----
# optional: Discord webhook URL; posts an embed for every new purchase
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_SEED=0

# ----- Privacy -----
ANONYMIZE=1                  # buyer names/UUIDs -> stable salted handles in API, CSV and Discord. 0 only for a private instance.
# ANON_SALT=                 # pin to keep handles identical across machines; otherwise generated into DATA_DIR/anon.salt

# ----- Storage -----
DATA_DIR=data
LOG_LEVEL=INFO
